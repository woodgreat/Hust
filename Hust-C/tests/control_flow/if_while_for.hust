//! Basic control flow test
//! Hust source:

void main() {
    i32 x = 10;
    
    if (x > 5) {
        println!("x is greater than 5");
    } else if (x == 5) {
        println!("x is equal to 5");
    } else {
        println!("x is less than 5");
    }
    
    while (x > 0) {
        println!("x = {}", x);
        x = x - 1;
    }
    
    for (i32 i = 0; i < 5; i++) {
        println!("i = {}", i);
    }
}

