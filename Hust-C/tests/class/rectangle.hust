//! Basic class definition test
//! Hust source:

class Rectangle {
    i32 width;
    i32 height;
    
    public Rectangle(i32 w, i32 h) {
        this.width = w;
        this.height = h;
    }
    
    public i32 getArea() {
        return this.width * this.height;
    }
    
    public void scale(i32 factor) {
        this.width = this.width * factor;
        this.height = this.height * factor;
    }
}

void main() {
    Rectangle rect = new Rectangle(10, 20);
    i32 area = rect.getArea();
    rect.scale(2);
}

