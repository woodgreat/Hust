//! Basic array test
//! Hust source:

void main() {
    // Fixed array
    i32[5] scores = {85, 90, 78, 92, 88};
    i32 first = scores[0];
    scores[1] = 95;
    
    // Dynamic array
    i32[] numbers;
    numbers.push(10);
    numbers.push(20);
    numbers.push(30);
    i32 len = numbers.len();
    i32 val = numbers[1];
    
    // Multi-dimensional array
    i32[3][4] matrix;
    matrix[0][0] = 1;
    matrix[2][3] = 12;
}

