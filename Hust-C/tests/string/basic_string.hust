//! Basic string test
//! Hust source:

void main() {
    String s = "Hello, World!";
    String empty;
    String cloned = s.clone();
    
    i32 len = s.len();
    char c = s.char_at(0);
    
    String concat = s + "!!!";
    bool eq = (s == "Hello, World!");
    
    println!("{}", s);
}

