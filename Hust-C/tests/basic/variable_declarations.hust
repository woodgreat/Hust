//! Basic variable declaration test
//! Hust source:

void main() {
    i32 x = 42;
    i32 y;
    i64 big = 1000000;
    f32 pi = 3.14;
    f64 e = 2.71828;
    bool flag = true;
    char c = 'A';
}

