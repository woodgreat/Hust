//! Basic function definition test
//! Hust source:

public i32 add(i32 a, i32 b) {
    return a + b;
}

public void greet(String name) {
    printf("Hello, %s!\n", name);
}

void main() {
    i32 result = add(1, 2);
    greet("World");
}

