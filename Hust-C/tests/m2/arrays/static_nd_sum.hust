use C.stdio.*;
void main() {
    i32[2][2][2] a = {0};
    a[0][0][0] = 1;
    a[0][0][1] = 1;
    a[0][1][0] = 1;
    a[0][1][1] = 1;
    a[1][0][0] = 1;
    a[1][0][1] = 1;
    a[1][1][0] = 1;
    a[1][1][1] = 1;
    i32 s = 0;
    for (i32 i = 0; i < 2; i++) {
        for (i32 j = 0; j < 2; j++) {
            for (i32 k = 0; k < 2; k++) {
                s = s + a[i][j][k];
            }
        }
    }
    printf("%d\n", s);
}
