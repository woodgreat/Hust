use GO.fmt.*;

class LinkedList {
    Node head;
    
    public LinkedList() {
        this.head = null;
    }
    
    public void add(i32 value) {
        Node newNode = new Node(value);
        if (this.head == null) {
            this.head = newNode;
        } else {
            Node current = this.head;
            while (current.next != null) {
                current = current.next;
            }
            current.next = newNode;
        }
    }
    
    public void print() {
        Node current = this.head;
        while (current != null) {
            fmt.Println(current.value);
            current = current.next;
        }
    }
    
    public i32 sum() {
        i32 total = 0;
        Node current = this.head;
        while (current != null) {
            total = total + current.value;
            current = current.next;
        }
        return total;
    }
}

class Node {
    i32 value;
    Node next;
    
    public Node(i32 v) {
        this.value = v;
        this.next = null;
    }
}

void main() {
    LinkedList list = new LinkedList();
    list.add(1);
    list.add(2);
    list.add(3);
    list.add(4);
    list.add(5);
    
    list.print();
    fmt.Println(list.sum());
}
