use GO.fmt.*;

class Point {
    f32 x;
    f32 y;
    
    public Point(f32 x, f32 y) {
        this.x = x;
        this.y = y;
    }
    
    public f32 distanceTo(Point other) {
        f32 dx = this.x - other.x;
        f32 dy = this.y - other.y;
        return sqrt(dx * dx + dy * dy);
    }
    
    public Point midpoint(Point other) {
        return new Point((this.x + other.x) / 2, (this.y + other.y) / 2);
    }
    
    public void print() {
        fmt.Println("(" + this.x + ", " + this.y + ")");
    }
}

class Line {
    Point start;
    Point end;
    
    public Line(Point s, Point e) {
        this.start = s;
        this.end = e;
    }
    
    public f32 length() {
        return this.start.distanceTo(this.end);
    }
    
    public Point midpoint() {
        return this.start.midpoint(this.end);
    }
    
    public f32 slope() {
        if (this.end.x == this.start.x) {
            return 0.0;
        }
        return (this.end.y - this.start.y) / (this.end.x - this.start.x);
    }
    
    public void print() {
        fmt.Println("Line from ");
        this.start.print();
        fmt.Println(" to ");
        this.end.print();
        fmt.Println("Length: " + this.length());
        fmt.Println("Slope: " + this.slope());
    }
}

class Triangle {
    Point a;
    Point b;
    Point c;
    
    public Triangle(Point a, Point b, Point c) {
        this.a = a;
        this.b = b;
        this.c = c;
    }
    
    public f32 perimeter() {
        return this.a.distanceTo(this.b) + 
               this.b.distanceTo(this.c) + 
               this.c.distanceTo(this.a);
    }
    
    public f32 area() {
        f32 ab = this.a.distanceTo(this.b);
        f32 bc = this.b.distanceTo(this.c);
        f32 ca = this.c.distanceTo(this.a);
        f32 s = this.perimeter() / 2;
        return sqrt(s * (s - ab) * (s - bc) * (s - ca));
    }
    
    public void print() {
        fmt.Println("Triangle with vertices:");
        this.a.print();
        this.b.print();
        this.c.print();
        fmt.Println("Perimeter: " + this.perimeter());
        fmt.Println("Area: " + this.area());
    }
}

f32 sqrt(f32 x) {
    if (x <= 0) {
        return 0.0;
    }
    f32 guess = x / 2;
    for (i32 i = 0; i < 10; i++) {
        guess = (guess + x / guess) / 2;
    }
    return guess;
}

void main() {
    Point p1 = new Point(0.0, 0.0);
    Point p2 = new Point(3.0, 4.0);
    Point p3 = new Point(6.0, 0.0);
    
    fmt.Println("Point p1:");
    p1.print();
    fmt.Println("Point p2:");
    p2.print();
    
    fmt.Println("Distance: " + p1.distanceTo(p2));
    
    Line line = new Line(p1, p2);
    line.print();
    
    Triangle tri = new Triangle(p1, p2, p3);
    tri.print();
}
