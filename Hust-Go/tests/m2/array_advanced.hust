use GO.fmt.*;

void main() {
    // Array initialization
    i32[] arr1 = {1, 2, 3};
    i32[] arr2 = {4, 5, 6};
    
    // Array concatenation
    i32[] arr3 = arr1 + arr2;
    
    fmt.Println(arr3.len());
    
    // Array slicing
    i32[] slice = arr3[1:4];
    fmt.Println(slice.len());
    
    // Array copy
    i32[] arr4 = arr1;
    arr4[0] = 10;
    fmt.Println(arr1[0]);
    fmt.Println(arr4[0]);
}
