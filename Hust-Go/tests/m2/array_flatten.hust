use GO.fmt.*;

void main() {
    // Array flattening
    i32[][] nested = {
        {1, 2, 3},
        {4, 5},
        {6, 7, 8, 9}
    };
    
    i32[] flat = {};
    for (i32 i = 0; i < nested.len(); i++) {
        for (i32 j = 0; j < nested[i].len(); j++) {
            flat.push(nested[i][j]);
        }
    }
    
    fmt.Println("Flattened:");
    for (i32 i = 0; i < flat.len(); i++) {
        fmt.Println(flat[i]);
    }
    
    // Array zipping
    String[] names = {"Alice", "Bob", "Charlie"};
    i32[] ages = {25, 30, 35};
    
    fmt.Println("Zipped:");
    for (i32 i = 0; i < names.len(); i++) {
        fmt.Println(names[i] + ": " + ages[i]);
    }
}
