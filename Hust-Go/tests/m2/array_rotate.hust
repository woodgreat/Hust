use GO.fmt.*;

void main() {
    // Array rotation
    i32[] arr = {1, 2, 3, 4, 5, 6, 7};
    i32 positions = 3;
    
    fmt.Println("Original:");
    for (i32 i = 0; i < arr.len(); i++) {
        fmt.Println(arr[i]);
    }
    
    // Rotate left
    i32[] rotated = {};
    for (i32 i = positions; i < arr.len(); i++) {
        rotated.push(arr[i]);
    }
    for (i32 i = 0; i < positions; i++) {
        rotated.push(arr[i]);
    }
    
    fmt.Println("Rotated left by " + positions + ":");
    for (i32 i = 0; i < rotated.len(); i++) {
        fmt.Println(rotated[i]);
    }
}
