use GO.fmt.*;

void main() {
    i32[][] matrix = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
    
    // 2D array access
    fmt.Println(matrix[0][0]);
    fmt.Println(matrix[1][1]);
    fmt.Println(matrix[2][2]);
    
    // 2D array iteration
    for (i32 i = 0; i < 3; i++) {
        for (i32 j = 0; j < 3; j++) {
            fmt.Println(matrix[i][j]);
        }
    }
}
