use GO.fmt.*;

void main() {
    for (i32 i = 0; i < 2; i++) {
        switch (i) {
            case 0:
                switch (i + 1) {
                    case 1:
                        fmt.Println("inner one");
                        break;
                    default:
                        fmt.Println("inner other");
                }
                break;
            default:
                fmt.Println("outer other");
        }
    }
}
