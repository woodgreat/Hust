use GO.fmt.*;

void main() {
    // Constants
    const i32 MAX_SIZE = 100;
    const f32 PI = 3.14159;
    const String APP_NAME = "Hust";
    
    fmt.Println(MAX_SIZE);
    fmt.Println(PI);
    fmt.Println(APP_NAME);
    
    // Const in expressions
    i32 area = MAX_SIZE * MAX_SIZE;
    fmt.Println(area);
    
    f32 circumference = 2 * PI * 5.0;
    fmt.Println(circumference);
}
