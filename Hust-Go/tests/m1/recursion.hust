use GO.fmt.*;

i32 factorial(i32 n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

i32 fibonacci(i32 n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

void main() {
    fmt.Println(factorial(5));
    fmt.Println(factorial(10));
    
    fmt.Println(fibonacci(10));
    fmt.Println(fibonacci(15));
}
