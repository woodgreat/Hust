<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>hust_csharp</AssemblyName>
    <RootNamespace>HustCSharp</RootNamespace>
    <!-- .NET assembly versions allow only 3-4 numeric parts, each <= 65535, so the
         Wood-style date suffix cannot live in Version. Keep the full version in
         InformationalVersion and Program.cs; NuGet sees a valid 3-part version. -->
    <Version>0.1.3</Version>
    <InformationalVersion>0.1.3.20261128125000</InformationalVersion>
    <Description>Hust language core for C#</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

</Project>
