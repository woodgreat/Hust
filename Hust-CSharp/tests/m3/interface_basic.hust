use CSHARP.Console.*;

// 形状接口：无返回类型，无参数类型
// C# 中接口和实现必须使用兼容类型，这里使用 object 作为通用类型
interface Shape {
    public object area();
    public object perimeter();
}

class Circle implements Shape {
    float radius;
    
    public object area() {
        return 3.14159 * radius * radius;
    }
    
    public object perimeter() {
        return 2 * 3.14159 * radius;
    }
}

class Rectangle implements Shape {
    float width;
    float height;
    
    public object area() {
        return width * height;
    }
    
    public object perimeter() {
        return 2 * (width + height);
    }
}

void main() {
    Circle c = new Circle();
    c.radius = 5.0;
    Console.WriteLine("Circle area: " + c.area());
    Console.WriteLine("Circle perimeter: " + c.perimeter());
    
    Rectangle r = new Rectangle();
    r.width = 4.0;
    r.height = 6.0;
    Console.WriteLine("Rectangle area: " + r.area());
    Console.WriteLine("Rectangle perimeter: " + r.perimeter());
}
