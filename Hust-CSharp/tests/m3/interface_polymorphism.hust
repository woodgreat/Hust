use CSHARP.Console.*;

interface Shape {
    public object area();
}

class Circle implements Shape {
    f32 radius;

    public Circle(f32 r) {
        this.radius = r;
    }

    public object area() {
        return 3.0 * this.radius * this.radius;
    }
}

class Square implements Shape {
    f32 side;

    public Square(f32 s) {
        this.side = s;
    }

    public object area() {
        return this.side * this.side;
    }
}

void main() {
    Shape a = new Circle(2.0);
    Shape b = new Square(3.0);

    Console.WriteLine(a.area());
    Console.WriteLine(b.area());
}
