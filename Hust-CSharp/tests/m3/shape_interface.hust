use CSHARP.Console.*;

// Shape interface - Hust 特色：形状接口定义行为契约
// 形状接口：无类型参数，只有名字，类型由实现类填写
// 注意：C# 中接口和实现必须使用相同类型，这里使用 object 作为通用类型
interface Drawable {
    public draw();
    public resize(object factor);
}

interface Serializable {
    public object serialize();
    public deserialize(object data);
}

// 实现形状接口
class Circle implements Drawable {
    float radius;
    
    public void draw() {
        Console.WriteLine("Drawing circle with radius: " + radius);
    }
    
    public void resize(object factor) {
        float f = (float)factor;
        radius = radius * f;
        Console.WriteLine("Resized to radius: " + radius);
    }
}

class DataRecord implements Serializable {
    string id;
    string content;
    
    public object serialize() {
        return id + ":" + content;
    }
    
    public void deserialize(object data) {
        // Simple parsing
        Console.WriteLine("Deserializing: " + data);
    }
}

void main() {
    Circle c = new Circle();
    c.radius = 5.0;
    c.draw();
    c.resize(2.0);
    
    DataRecord rec = new DataRecord();
    rec.id = "001";
    rec.content = "test data";
    object serialized = rec.serialize();
    Console.WriteLine("Serialized: " + serialized);
    rec.deserialize(serialized);
}
