use CSHARP.Console.*;

// 形状接口：无返回类型，无参数类型
interface Drawable {
    public draw();
}

interface Printable {
    public print();
}

class Document : Drawable, Printable {
    string title;
    
    public void draw() {
        Console.WriteLine("Drawing: " + title);
    }
    
    public void print() {
        Console.WriteLine("Printing: " + title);
    }
}

void main() {
    Document doc = new Document();
    doc.title = "Report";
    doc.draw();
    doc.print();
}
