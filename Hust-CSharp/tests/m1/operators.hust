use CSHARP.Console.*;

void main() {
    i32 a = 10;
    i32 b = 3;

    Console.WriteLine(a + b);
    Console.WriteLine(a - b);
    Console.WriteLine(a * b);
    Console.WriteLine(a / b);
    Console.WriteLine(a % b);

    Console.WriteLine(a > b);
    Console.WriteLine(a == b);
    Console.WriteLine(a != b);

    bool t = true;
    bool f = false;
    Console.WriteLine(t && f);
    Console.WriteLine(t || f);
    Console.WriteLine(!t);

    Console.WriteLine(a & b);
    Console.WriteLine(a | b);
    Console.WriteLine(a ^ b);
    Console.WriteLine(~a);
    Console.WriteLine(a << 1);
    Console.WriteLine(a >> 1);

    i32 max = a > b ? a : b;
    Console.WriteLine(max);
}
