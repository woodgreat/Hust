use CSHARP.Console.*;

void main() {
    i32 x = 10;

    x += 5;
    Console.WriteLine(x);
    x -= 3;
    Console.WriteLine(x);
    x *= 2;
    Console.WriteLine(x);
    x /= 4;
    Console.WriteLine(x);
    x %= 4;
    Console.WriteLine(x);

    x = 10;
    x &= 3;
    Console.WriteLine(x);
    x |= 8;
    Console.WriteLine(x);
    x ^= 3;
    Console.WriteLine(x);
    x <<= 2;
    Console.WriteLine(x);
    x >>= 3;
    Console.WriteLine(x);
}
