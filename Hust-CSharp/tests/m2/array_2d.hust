use CSHARP.Console.*;

void main() {
    i32[][] matrix = {{1, 2, 3}, {4, 5, 6}};

    Console.WriteLine(matrix.len());
    Console.WriteLine(matrix[0].len());
    Console.WriteLine(matrix[0][0]);
    Console.WriteLine(matrix[1][2]);

    i32 sum = 0;
    for (i32 i = 0; i < matrix.len(); i++) {
        for (i32 j = 0; j < matrix[i].len(); j++) {
            sum = sum + matrix[i][j];
        }
    }
    Console.WriteLine(sum);
}
