use CSHARP.Console.*;

void main() {
    i32[] arr = {1, 2, 3, 4, 5};

    Console.WriteLine(arr.Length);
    Console.WriteLine(arr[0]);
    Console.WriteLine(arr[4]);

    i32 sum = 0;
    for (i32 i = 0; i < arr.len(); i++) {
        sum = sum + arr[i];
    }
    Console.WriteLine(sum);

    arr[0] = 10;
    Console.WriteLine(arr[0]);
}
