void main() {
    i32[2][2][2] a3;
    i32 sum = 0;
    for (i32 i = 0; i < 2; i++) {
        for (i32 j = 0; j < 2; j++) {
            for (i32 k = 0; k < 2; k++) {
                a3[i][j][k] = 1;
            }
        }
    }
    for (i32 i = 0; i < 2; i++) {
        for (i32 j = 0; j < 2; j++) {
            for (i32 k = 0; k < 2; k++) {
                sum = sum + a3[i][j][k];
            }
        }
    }
    println!("a3: sum = {}", sum);
}
