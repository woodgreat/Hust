// Inheritance test - V0.6

class Animal {
    i32 age;
    
    public void eat() {
        println!("Animal eating");
    }
    
    public i32 getAge() {
        return self.age;
    }
}

class Dog extends Animal {
    String name;
    
    public void bark() {
        println!("Woof!");
    }
}

void main() {
    // Initialize with default values to avoid E0381
    Dog d = Dog { Animal: Animal { age: 5 }, name: "".to_string() };
    
    d.Animal.eat();
    println!("Age: {}", d.Animal.getAge());
    d.bark();
    
    println!("Inheritance test passed!");
}
