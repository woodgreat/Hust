// inheritance_test.hust — 单层继承 + 父类成员访问 d.Animal.x（方法名须 snake_case）

class Animal {
    i32 age;
    
    public void eat() {
        println!("Animal eating");
    }
    
    public i32 get_age() {
        return this.age;
    }
}

class Dog extends Animal {
    String name;
    
    public Dog() {}
    
    public void bark() {
        println!("Woof!");
    }
}

void main() {
    Dog d = new Dog();
    d.Animal.age = 5;
    
    d.Animal.eat();
    println!("Age: {}", d.Animal.get_age());
    d.bark();
    
    println!("Inheritance test passed!");
}
