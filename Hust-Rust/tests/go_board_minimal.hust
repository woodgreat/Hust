// Minimal Go board test - no extra methods
class Board {
    i32[19][19] grid;
    i32 size;
    
    public Board() {
        self.size = 19;
        for (i32 i = 0; i < 19; i = i + 1) {
            for (i32 j = 0; j < 19; j = j + 1) {
                self.grid[i][j] = 0;
            }
        }
    }
    
    public bool is_valid(i32 x, i32 y) {
        return x >= 0 && x < self.size && y >= 0 && y < self.size;
    }
    
    public bool place_stone(i32 x, i32 y, i32 color) {
        if (!self.is_valid(x, y)) {
            return false;
        }
        if (self.grid[x][y] != 0) {
            return false;
        }
        self.grid[x][y] = color;
        return true;
    }
}

void main() {
    Board board = new Board();
    bool ok = board.place_stone(3, 3, 1);
    println!("ok = {}", ok);
}
