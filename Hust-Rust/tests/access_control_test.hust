// Access Control Test
// Test class, field, and method visibility

public class PublicClass {
    public i32 public_field;
    i32 private_field;
    
    public void public_method() {
        self.public_field = 10;
        self.private_field = 20;  // OK: same class can access private
    }
    
    void private_method() {
        self.public_field = 30;
        self.private_field = 40;  // OK: same class can access private
    }
}

class PrivateClass {
    public i32 public_field;
    i32 private_field;
    
    public void public_method() {
        self.private_field = 50;  // OK: same class
    }
}

void main() {
    // Initialize with default values to avoid E0381
    PublicClass pc = PublicClass { public_field: 100, private_field: 0 };
    pc.public_method();          // OK: public method
    
    PrivateClass prv = PrivateClass { public_field: 300, private_field: 0 };
    prv.public_method();         // OK: public method
    
    println!("Access control test passed!");
}
