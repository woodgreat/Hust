// interface_test.hust — 接口定义与实现（方法名须 snake_case）

interface Drawable {
    public void draw();
    public getArea();
}

class Rectangle implements Drawable {
    i32 width;
    i32 height;
    
    public void draw() {
        println!("Drawing rectangle");
    }
    
    public i32 get_area() {
        return this.width * this.height;
    }
}

void main() {
    Rectangle r = new Rectangle();
    r.width = 10;
    r.height = 5;
    
    r.draw();
    println!("Area: {}", r.get_area());
    
    println!("Interface test passed!");
}
