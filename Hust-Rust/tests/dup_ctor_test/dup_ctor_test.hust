// Duplicate constructor teaching-error test (wood 2026-10-03, r46 B-plan).
// A class declaring two constructors must be rejected by the Hust
// transpiler with guidance, not fall through to rustc E0592.

class Point {
    i32 x;

    public Point() {
        self.x = 0;
    }

    public Point(i32 v) {
        self.x = v;
    }
}

void main() {
    Point a = new Point();
    Point b = new Point(5);
    println!("dup_ctor_test: should never compile");
}
