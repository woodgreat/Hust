// Class test v2 - simplified methods

class Point {
    i32 x;
    i32 y;
    
    public Point() {}
    
    public i32 getX() { return this.x; }
    public i32 getY() { return this.y; }
    public void setX(i32 val) { this.x = val; }
}

void main() {
    Point p = new Point();
    p.setX(10);
    
    println!("X: {}", p.getX());
    println!("Class v2 test passed!");
}
