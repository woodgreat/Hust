// Class test v2 - simplified methods

class Point {
    i32 x;
    i32 y;
    
    public Point() {}
    
    public i32 get_x() { return this.x; }
    public i32 get_y() { return this.y; }
    public void set_x(i32 val) { this.x = val; }
}

void main() {
    Point p = new Point();
    p.set_x(10);
    
    println!("X: {}", p.get_x());
    println!("Class v2 test passed!");
}
