// Nested Class Test — 测试嵌套类 Outer.Inner 的扁平化与方法内 this 改写（B22）
// Test basic nested class definition and usage

class Outer {
    i32 outer_field;
    
    class Inner {
        i32 inner_field;
        
        public Inner() {}
        
        public i32 get_value() {
            return this.inner_field;
        }
    }
    
    public Outer() {}
    
    public void init() {
        this.outer_field = 10;
    }
}

void main() {
    Outer o = new Outer();
    o.init();
    
    // Access nested class
    Outer.Inner inner = new Outer.Inner();
    inner.inner_field = 42;
    
    i32 val = inner.get_value();
    println!("Value: {}", val);
}
