interface Printer {
    public void print(content);
}

class TextPrinter implements Printer {
    public TextPrinter() {}
    public void print(String content) {
        println!("Text: {}", content);
    }
}

class FancyPrinter implements Printer {
    public FancyPrinter() {}
    public void print(String content) {
        println!("[fancy] {}", content);
    }
}

class Notifier {
    public Notifier() {}
    public void notify(Printer(String) p, i32 times) {
        for (i32 i = 0; i < times; i++) {
            p.print("ping");
        }
    }
}

void main() {
    Notifier n = new Notifier();
    n.notify(new TextPrinter(), 1);
    n.notify(new FancyPrinter(), 2);
}
