// Shape interface with return variable name and multiple params
interface Shape {
    public areaSize area(width, height);  // areaSize = return var, width/height = param vars
}

class Rect implements Shape {
    public f64 area(f64 width, f64 height) { return width * height; }  // f64 fills all
}

class Circle implements Shape {
    // Param names must match interface: width, height
    // Semantically: width=radius, height=pi
    public f64 area(f64 width, f64 height) { return height * width * width; }
}

void main() {
    Rect s = new Rect();
    println!("rect area = {}", s.area(3.0, 4.0));
    
    Circle c = new Circle();
    println!("circle area = {}", c.area(2.0, 3.14159));
}
